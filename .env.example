# Copy to .env and fill in (never commit .env)

IRCTC_USERNAME=your_irctc_user_id
IRCTC_PASSWORD=your_password
# Aadhaar-verified: expect login CAPTCHA only (session saved under .auth/)

# Journey
FROM_STATION=NDLS
TO_STATION=BCT
JOURNEY_DATE=2026-10-20
QUOTA=TQ
CLASS=3A

# Tatkal: train number (5 digits) — script clicks class + Book Now
TRAIN_NUMBER=12301
# TRAIN_NAME=RAJDHANI

# Start search at Tatkal open (10:00 AC / 11:00 non-AC IST)
# TATKAL_SYNC=1
# TATKAL_RETRY_SECONDS=180

# Saved family list (dropdown: "Name | age yrs | Gender")
PASSENGERS=Sajal Kumar, Debasis Patra
# PASSENGERS=Sajal Kumar,Shilpa Rani
# PASSENGER_PREFER_VERIFIED=true

# Optional: reuse saved session (set after first successful login)
# STORAGE_STATE_PATH=.auth/irctc-storage.json

# Run with visible browser (recommended for CAPTCHA)
# HEADED=1

# Keep browser open at payment page until you close it (default: on)
# KEEP_OPEN=1
# KEEP_OPEN=0
